{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "47bf6a29-1ae0-4489-aa6f-4fc53f3453b1","database_name": "web-appArmitaASr" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b3d0fd89ead64d6ba1772c0cacb760b7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
